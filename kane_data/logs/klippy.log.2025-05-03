[gcode_macro MPC_Extruder]
gcode = 
	MPC_CALIBRATE HEATER=extruder

[gcode_macro calabrate_extruder]
gcode = 
	{% set length = params.LENGTH|default(100)|float %}
	{% set target = params.TARGET|float %}
	{% set min_temp = printer.configfile.settings.extruder.min_extrude_temp|int %}
	{% if not printer.extruder.can_extrude %}
	RESPOND TYPE=error MSG="Below minimum temp. Heating extruder..."
	M109 S{min_temp|int}
	{% endif %}
	{% if params.TARGET is defined %}
	{% if min_temp|int < target|float %}
	M109 S{target}
	M117 Heating nozzle...
	{% endif %}
	{% endif %}
	M117 EXTRUDING...
	G92 E0
	G91 E{length} F60
	G92 E0

[gcode_macro Calibrate_Home]
gcode = 
	G4 P4000
	M190 S75
	M109 S190
	PERCISE_HOME
	G4 P1000
	PROBE_CALIBRATE

[extruder]
step_pin = PD15
dir_pin = !PD14
enable_pin = !PC7
heater_pin = PB3
