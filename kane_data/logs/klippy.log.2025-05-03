[gcode_macro M600]
gcode = 
	
	
	
	
	
	
	SAVE_GCODE_STATE NAME=M600_state
	PAUSE
	
	
	
	
	
	
	
	
	UNLOAD_FILAMENT
	SET_FILAMENT_SENSOR SENSOR=runout_sensor ENABLE=0

[gcode_macro SWAP_RESUME]
gcode = 
	LOAD_FILAMENT
	RESTORE_GCODE_STATE NAME=M600_state
	SET_FILAMENT_SENSOR SENSOR=runout_sensor ENABLE=1
	resume

[idle_timeout]
timeout = 300
gcode = 
	M117 Timeout reached
	{% if printer.pause_resume.is_paused %}
	SET_IDLE_TIMEOUT TIMEOUT=7800
	{% else %}
	M84
	SET_HEATER_TEMPERATURE HEATER=extruder TARGET=0
	STATUS
	M117 Need Re-Home
	{% endif %}

[gcode_macro UNLOAD_FILAMENT]
gcode = 
	{% set length = params.LENGTH|default(100)|float %}
	{% set target = params.TARGET|default(240)|float %}
	
	{% set cur_temp = printer.extruder.temperature|float %}
	{% set min_temp = printer.configfile.settings.extruder.min_extrude_temp|int %}
	{% if not printer.extruder.can_extrude %}
	RESPOND TYPE=error MSG="Below minimum temp. Heating extruder..."
	M109 S{min_temp|int}
	{% endif %}
	{% if params.TARGET is defined %}
	{% if cur_temp|float < target|float or min_temp|int < target|int %}
	M109 S{target}
	M117 Heating nozzle...
	{% endif %}
	{% endif %}
	
	G92 E0
	G1 E7.0 F1200
	G1 E2.0 F1600
	G4 P300
	G92 E0
	G1 E-10.0 F4000
	G92 E0
	G4 P600
	G1 E-{length} F3000
	G92 E0
	CLEAR_ACTIVE_SPOOL

[gcode_macro LOAD_FILAMENT]
gcode = 
	{% set slow = params.SLOW|default(20)|float %}
	{% set fast = params.FAST|default(40)|float %}
	
	{% set target = params.TARGET|default(220)|float %}
	{% set cur_temp = printer.extruder.temperature|float %}
	{% set min_temp = printer.configfile.settings.extruder.min_extrude_temp|int %}
	{% if not printer.extruder.can_extrude %}
	RESPOND TYPE=error MSG="Below minimum temp. Heating extruder..."
	M109 S{min_temp|int}
	{% endif %}
	{% if params.TARGET is defined %}
	{% if cur_temp|float < target|float or min_temp|int < target|float %}
	M109 S{target}
	M117 Heating nozzle...
	{% endif %}
	{% endif %}
	M117  LOADING...
	G92 E0
	G4 P5000
	G1 E15.0 F1000
	G1 E{fast} F1200
	G4 P900
	G92 E0
	G1 E{slow} F450
	G92 E0
	SET_IDLE_TIMEOUT TIMEOUT=600

[gcode_macro PURGE]
gcode = 
	{% set LENGTH = params.LENGTH|default(45)|float %}
	
	{% set target = params.TARGET|default(220)|float %}
	{% set cur_temp = printer.extruder.temperature|float %}
	{% set min_temp = printer.configfile.settings.extruder.min_extrude_temp|int %}
	{% if not printer.extruder.can_extrude %}
	RESPOND TYPE=error MSG="Below minimum temp. Heating extruder..."
	M109 S{min_temp|int}
	{% endif %}
	{% if params.TARGET is defined %}
	{% if cur_temp|float < target|float or min_temp|int < target|float %}
	M109 S{target}
	M117 Heating nozzle...
	{% endif %}
	{% endif %}
	M117 PURGING..
	G91
	G1 E{LENGTH} F250
	G90

