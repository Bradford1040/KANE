Args: ['/home/octo/klipper/klippy/klippy.py', '/home/octo/kane_data/config/printer.cfg', '-I', '/home/octo/kane_data/comms/klippy.serial', '-l', '/home/octo/kane_data/logs/klippy.log', '-a', '/home/octo/kane_data/comms/klippy.sock']
